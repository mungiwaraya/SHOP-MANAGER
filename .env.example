# ─────────────────────────────────────────────────────────────
# Shop Manager — Environment Variables
# Copy this file to `.env` and fill in your Supabase project values.
# Find these under: Supabase Dashboard → Project Settings → API
# ─────────────────────────────────────────────────────────────

# Supabase project URL (public)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon/public key (safe for the browser — RLS protects your data)
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ⚠️ NEVER put the service_role key anywhere in this project or repository.
